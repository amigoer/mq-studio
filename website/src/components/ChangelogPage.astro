---
import Subpage from '@/components/Subpage.astro';
import { t, localePath, formatDate, type Locale } from '@/i18n';
import { releases, inline, type Release } from '@/lib/changelog';
import { RELEASES_URL } from '@/lib/downloads';

interface Props {
  locale: Locale;
  /** The release this page is about. */
  current: Release;
  /**
   * Set on /changelog/, which renders the newest release. It points its
   * canonical at that release's own page rather than duplicating it.
   */
  isIndex?: boolean;
}

const { locale, current, isIndex = false } = Astro.props;
const c = t(locale);
const entries = releases(locale);
const latest = entries.find((entry) => !entry.unreleased);

/** /changelog/<id>/ for every release, the newest included. */
function pathFor(entry: Release): string {
  return localePath(locale, `changelog/${entry.id}`);
}

const selfPath = pathFor(current);
const title = isIndex ? c.changelog.metaTitle : `${current.version} · ${c.changelog.title} — MQ Studio`;
const date = current.date ? formatDate(current.date, locale) : null;
const description = `MQ Studio ${current.version}${date ? ` (${date})` : ''} — ${c.changelog.metaDescription}`;

// Newest first in the file, so the neighbour above is the newer release.
const position = entries.findIndex((entry) => entry.id === current.id);
const newer = position > 0 ? entries[position - 1] : null;
const older = position >= 0 && position < entries.length - 1 ? entries[position + 1] : null;

// The index alone already makes these unique; the slug is only there to make
// the fragment readable, and a Chinese heading slugifies to nothing.
const sectionId = (title: string, index: number) => {
  const slug = title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
  return slug ? `s-${index}-${slug}` : `s-${index}`;
};

// Section titles double as the right-hand table of contents.
const toc = current.sections.flatMap((section, index) =>
  section.title ? [{ href: `#${sectionId(section.title, index)}`, label: section.title }] : [],
);
---

<Subpage
  locale={locale}
  path={`changelog/${current.id}`}
  canonicalPath={isIndex ? selfPath : undefined}
  title={title}
  description={description}
  crumb={c.changelog.title}
  heading={c.changelog.title}
  lead={c.changelog.lead}
  railLabel={c.changelog.onThisPage}
  toc={toc}
  tocLabel={c.changelog.inThisRelease}
>
  <ul
    slot="rail"
    class="flex gap-2 overflow-x-auto pb-2 [scrollbar-width:none] lg:max-h-[calc(100vh-10rem)] lg:flex-col lg:gap-1 lg:overflow-y-auto lg:pb-0 [&::-webkit-scrollbar]:hidden"
  >
    {
      entries.map((entry) => {
        const active = entry.id === current.id;
        return (
          <li class="flex-none lg:flex-auto">
            <a
              href={pathFor(entry)}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between gap-2 whitespace-nowrap rounded-lg px-3 py-1.5 font-mono text-caption transition-colors lg:px-3 lg:py-2',
                active
                  ? 'bg-secondary font-semibold text-foreground'
                  : 'border border-border text-muted-foreground hover:bg-secondary hover:text-foreground lg:border-transparent',
              ]}
            >
              {entry.version}
              {/* Text, not a bare dot: a dot would be aria-hidden, and the rail
                  has to tell a screen reader which release is current. */}
              {entry === latest && (
                <span class="rounded-full bg-success/10 px-1.5 py-0.5 font-sans text-2xs font-semibold text-success">
                  {c.changelog.latest}
                </span>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>

  <article class="max-w-measure">
    <header class="border-b border-border pb-4">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <h2 class="text-display-sm font-extrabold tracking-display">{current.version}</h2>
        {
          current === latest && (
            <span class="rounded-full bg-success/10 px-2.5 py-1 text-2xs font-semibold text-success">
              {c.changelog.latest}
            </span>
          )
        }
      </div>
      {
        current.date && (
          <time datetime={current.date} class="mt-1.5 block text-ui text-subtle-foreground">
            {date}
          </time>
        )
      }
    </header>

    <!-- The wrapper is what the CI verify step counts paragraphs inside. -->
    <div data-changelog-intro>
      {
        current.intro.map((paragraph) => (
          <p class="mt-5 text-prose text-prose-foreground text-pretty" set:html={inline(paragraph)} />
        ))
      }
    </div>

    {
      current.sections.map((section, index) => (
        <section id={section.title ? sectionId(section.title, index) : undefined} class="mt-9 scroll-mt-24">
          {section.title && <h3 class="text-lead font-bold tracking-tight">{section.title}</h3>}
          {section.blocks.map((block) =>
            block.type === 'subheading' ? (
              <p data-subheading class="mt-6 text-prose font-semibold" set:html={inline(block.text)} />
            ) : block.type === 'paragraph' ? (
              <p class="mt-4 text-prose text-prose-foreground text-pretty" set:html={inline(block.text)} />
            ) : (
              <ul class="mt-3 list-disc space-y-2.5 pl-5 marker:text-subtle-foreground">
                {block.items.map((item) => (
                  <li class="pl-1 text-prose text-prose-foreground">
                    {item.paragraphs.map((paragraph, paragraphIndex) => (
                      <p class:list={[paragraphIndex > 0 && 'mt-2']} set:html={inline(paragraph)} />
                    ))}
                  </li>
                ))}
              </ul>
            ),
          )}
        </section>
      ))
    }

    <div class="mt-12 border-t border-border pt-5">
      <a
        href={`${RELEASES_URL}/tag/v${current.version}`}
        class="inline-flex items-center gap-1.5 text-ui font-medium transition-colors hover:text-muted-foreground"
      >
        {c.changelog.onGitHub} →
      </a>
    </div>
  </article>

  <!-- Outside the article: the verify step wants the article to hold exactly
       one release, and these name two others. -->
  {
    (older || newer) && (
      <nav aria-label={c.changelog.pagination} class="mt-6 flex max-w-measure justify-between gap-4 text-ui">
        {older ? (
          <a
            href={pathFor(older)}
            class="inline-flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6" />
            </svg>
            <span class="text-caption">{c.changelog.older}</span>
            <span class="font-mono font-medium text-foreground">{older.version}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a
            href={pathFor(newer)}
            class="inline-flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
          >
            <span class="text-caption">{c.changelog.newer}</span>
            <span class="font-mono font-medium text-foreground">{newer.version}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </a>
        )}
      </nav>
    )
  }
</Subpage>
