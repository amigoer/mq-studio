---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/sections/Nav.astro';
import Footer from '@/components/sections/Footer.astro';
import { t, localePath, type Locale } from '@/i18n';
import { releases, inline, type Release } from '@/lib/changelog';
import { RELEASES_URL } from '@/lib/downloads';

interface Props {
  locale: Locale;
  /** The release this page is about. */
  current: Release;
  /**
   * Set on /changelog/, which renders the newest release. It points its
   * canonical at that release's own page rather than duplicating it.
   */
  isIndex?: boolean;
}

const { locale, current, isIndex = false } = Astro.props;
const c = t(locale);
const entries = releases(locale);
const latest = entries.find((entry) => !entry.unreleased);

/** /changelog/ for the newest release, /changelog/<id>/ for the rest. */
function pathFor(entry: Release): string {
  return localePath(locale, `changelog/${entry.id}`);
}

const selfPath = pathFor(current);
const title = `${current.version} · ${c.changelog.title} — MQ Studio`;
const description = `MQ Studio ${current.version}${current.date ? ` (${current.date})` : ''} — ${c.changelog.metaDescription}`;

// Section titles double as the right-hand table of contents.
const toc = current.sections.filter((section) => section.title);
// The index alone already makes these unique; the slug is only there to make
// the fragment readable, and a Chinese heading slugifies to nothing.
const sectionId = (title: string, index: number) => {
  const slug = title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
  return slug ? `s-${index}-${slug}` : `s-${index}`;
};
---

<Base
  locale={locale}
  path={`changelog/${current.id}`}
  canonicalPath={isIndex ? selfPath : undefined}
  title={title}
  description={description}
>
  <Nav locale={locale} />

  <main id="top" class="mx-auto max-w-[1240px] px-6 py-10 sm:py-14">
    <a
      href={localePath(locale)}
      class="inline-flex items-center gap-1.5 text-[13px] text-muted-foreground transition-colors hover:text-foreground"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
      {c.changelog.backHome}
    </a>

    <div class="mt-5 lg:grid lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[200px_minmax(0,1fr)_180px]">
      <!-- Version list. A sticky rail on large screens, a scrolling strip of
           pills above the content on small ones. -->
      <nav aria-label={c.changelog.onThisPage} class="lg:sticky lg:top-20 lg:self-start">
        <p class="mb-3 hidden items-center gap-2 text-[13px] font-semibold lg:flex">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground" aria-hidden="true">
            <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
            <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
          </svg>
          {c.changelog.onThisPage}
        </p>
        <ul
          class="flex gap-2 overflow-x-auto pb-2 [scrollbar-width:none] lg:max-h-[calc(100vh-10rem)] lg:flex-col lg:gap-1 lg:overflow-y-auto lg:pb-0 [&::-webkit-scrollbar]:hidden"
        >
          {
            entries.map((entry) => {
              const active = entry.id === current.id;
              return (
                <li class="flex-none lg:flex-auto">
                  <a
                    href={pathFor(entry)}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex items-center justify-between gap-2 whitespace-nowrap rounded-lg px-3 py-1.5 font-mono text-[12.5px] transition-colors lg:px-3 lg:py-2',
                      active
                        ? 'bg-secondary font-semibold text-foreground'
                        : 'border border-border text-muted-foreground hover:bg-secondary hover:text-foreground lg:border-transparent',
                    ]}
                  >
                    {entry.version}
                    {/* Text, not the bare dot this used to be: the dot was
                        aria-hidden, so the rail told a screen reader nothing
                        about which release is current. */}
                    {entry === latest && (
                      <span class="rounded-full bg-success/10 px-1.5 py-0.5 font-sans text-[10px] font-semibold text-success">
                        {c.changelog.latest}
                      </span>
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <article class="mt-8 min-w-0 lg:mt-0">
        <header class="border-b border-border pb-4">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <h1 class="text-[30px] font-extrabold tracking-[-0.03em] sm:text-[36px]">
              {current.version}
            </h1>
            {
              current === latest && (
                <span class="rounded-full bg-success/10 px-2.5 py-1 text-[11px] font-semibold text-success">
                  {c.changelog.latest}
                </span>
              )
            }
          </div>
          {
            current.date && (
              <time datetime={current.date} class="mt-1.5 block font-mono text-[13px] text-subtle-foreground">
                {current.date}
              </time>
            )
          }
        </header>

        <!-- The wrapper is what the CI verify step counts paragraphs inside. -->
        <div data-changelog-intro>
          {
            current.intro.map((paragraph) => (
              <p
                class="mt-5 text-[14.5px] leading-[1.75] text-muted-foreground text-pretty"
                set:html={inline(paragraph)}
              />
            ))
          }
        </div>

        {
          current.sections.map((section, index) => (
            <section id={section.title ? sectionId(section.title, index) : undefined} class="mt-9 scroll-mt-24">
              {section.title && (
                <h2 class="text-[15px] font-bold tracking-tight">{section.title}</h2>
              )}
              {section.blocks.map((block) =>
                block.type === 'subheading' ? (
                  <p data-subheading class="mt-5 text-[13.5px] font-semibold" set:html={inline(block.text)} />
                ) : block.type === 'paragraph' ? (
                  <p
                    class="mt-4 text-[13.5px] leading-[1.75] text-muted-foreground text-pretty"
                    set:html={inline(block.text)}
                  />
                ) : (
                  <ul class="mt-3 list-disc space-y-2.5 pl-5 marker:text-subtle-foreground">
                    {block.items.map((item) => (
                      <li class="pl-1 text-[13.5px] leading-[1.75] text-muted-foreground">
                        {item.paragraphs.map((paragraph, index) => (
                          <p class:list={[index > 0 && 'mt-2']} set:html={inline(paragraph)} />
                        ))}
                      </li>
                    ))}
                  </ul>
                ),
              )}
            </section>
          ))
        }

        <div class="mt-12 border-t border-border pt-5">
          <a
            href={`${RELEASES_URL}/tag/v${current.version}`}
            class="inline-flex items-center gap-1.5 text-[13.5px] font-medium transition-colors hover:text-muted-foreground"
          >
            {c.changelog.onGitHub} →
          </a>
        </div>
      </article>

      <!-- Section index for the release being read. Large screens only: below
           xl it would push the content column too narrow to be worth it. -->
      {
        toc.length > 1 && (
          <nav aria-label={c.changelog.inThisRelease} class="hidden xl:sticky xl:top-20 xl:block xl:self-start">
            <p class="mb-3 text-[12.5px] font-semibold text-muted-foreground">
              {c.changelog.inThisRelease}
            </p>
            <ul class="flex flex-col gap-2 border-l border-border">
              {current.sections.map((section, index) =>
                section.title ? (
                  <li>
                    <a
                      href={`#${sectionId(section.title, index)}`}
                      class="-ml-px block border-l border-transparent pl-3 text-[13px] text-muted-foreground transition-colors hover:border-foreground hover:text-foreground"
                    >
                      {section.title}
                    </a>
                  </li>
                ) : null,
              )}
            </ul>
          </nav>
        )
      }
    </div>
  </main>

  <Footer locale={locale} />
</Base>
