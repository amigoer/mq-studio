---
/*
 * Platform marks for the download menu and cards. Inline rather than files so
 * they cost no request, inherit `currentColor`, and follow the theme.
 *
 * The Apple and Windows outlines are Bootstrap Icons (MIT). Tux is drawn here:
 * the real one carries far too much detail to read at 13px, so this keeps the
 * silhouette and the eyes and drops the rest.
 */
interface Props {
  platform: 'mac' | 'windows' | 'linux';
  size?: number;
  class?: string;
}

const { platform, size = 13, class: className } = Astro.props;

const label = { mac: 'macOS', windows: 'Windows', linux: 'Linux' }[platform];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="currentColor"
  role="img"
  aria-label={label}
  class={className}
>
  {
    platform === 'mac' && (
      <>
        <path d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516.024.034 1.512.087 2.442-1.026.93-1.114.808-2.624.76-2.662Z" />
        <path d="M14.496 11.74c-.048-.096-2.325-1.234-2.113-3.422.212-2.189 1.675-2.789 1.698-2.854.023-.065-.597-.79-1.254-1.157a3.692 3.692 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116-.508.139-1.653.589-1.968.607-.316.018-1.256-.522-2.267-.665-.647-.125-1.333.131-1.824.328-.49.196-1.422.754-2.074 2.237-.652 1.482-.311 3.83-.067 4.56.244.729.625 1.924 1.273 2.796.576.984 1.34 1.667 1.659 1.899.319.232 1.219.386 1.843.067.502-.308 1.408-.485 1.766-.472.357.013 1.061.154 1.782.539.571.197 1.111.115 1.652-.105.541-.221 1.324-1.059 2.238-2.758.347-.79.505-1.217.473-1.282Z" />
      </>
    )
  }
  {
    platform === 'windows' && (
      <path d="M6.555 1.375 0 2.237v5.45h6.555V1.375zM0 13.795l6.555.933V8.313H0v5.482zm7.278-5.4.026 6.378L16 16V8.395H7.278zM16 0 7.33 1.244v6.414H16V0z" />
    )
  }
  {
    platform === 'linux' && (
      <path
        fill-rule="evenodd"
        d="M8 .6c1.9 0 3.1 1.45 3.1 3.35 0 .62-.03 1.06.15 1.48.2.48.68.95 1.2 1.75.76 1.05 1.4 2.3 1.72 3.45.22.78.24 1.48-.02 1.95-.26.47-.75.68-1.24.58-.14 1.03-.5 1.85-1.15 2.4-.9.76-2.2 1.09-3.76 1.09s-2.86-.33-3.76-1.09c-.65-.55-1.01-1.37-1.15-2.4-.49.1-.98-.11-1.24-.58-.26-.47-.24-1.17-.02-1.95.32-1.15.96-2.4 1.72-3.45.52-.8 1-1.27 1.2-1.75.18-.42.15-.86.15-1.48C4.9 2.05 6.1.6 8 .6Zm-1.15 2.6a.72.72 0 0 0-.71.78c0 .47.31.85.71.85.4 0 .72-.38.72-.85a.72.72 0 0 0-.72-.78Zm2.3 0a.72.72 0 0 0-.72.78c0 .47.32.85.72.85.4 0 .71-.38.71-.85a.72.72 0 0 0-.71-.78ZM8 5.35c-.62 0-1.16.3-1.16.7 0 .39.54.7 1.16.7.62 0 1.15-.31 1.15-.7 0-.4-.53-.7-1.15-.7Z"
      />
    )
  }
</svg>
