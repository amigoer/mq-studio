---
import { t, localePath, type Locale } from '@/i18n';
import { RELEASE, RELEASES_URL, formatSize, mac, windows, linux, type ReleaseFile } from '@/lib/downloads';
import PlatformPicker, { type Segment, type Variant } from '@/components/widgets/PlatformPicker.astro';
import PlatformIcon from '@/components/widgets/PlatformIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale);
const d = c.download;
const a = d.archLabels;

const installDoc = localePath(locale, 'docs/install');
// The lead names the checksum file; this is where it becomes a link.
const [beforeChecksums, afterChecksums = ''] = d.leadSuffix.split('{checksums}');

const variant = (key: string, file: ReleaseFile): Variant => ({
  key,
  name: file.name,
  url: file.url,
  alternate: file.alternate,
  size: formatSize(file.size),
});

const macSegments: Segment[] = [
  {
    label: d.selectArch,
    defaultValue: 'arm64',
    options: [
      { value: 'arm64', label: a.arm64 },
      { value: 'amd64', label: a.amd64 },
    ],
  },
];
const macVariants: Variant[] = (['arm64', 'amd64'] as const).map((arch) => variant(arch, mac(arch)));

const winSegments: Segment[] = [
  {
    label: d.selectArch,
    defaultValue: 'amd64',
    options: [
      { value: 'amd64', label: a.winAmd64 },
      { value: 'arm64', label: a.winArm64 },
    ],
  },
];
const winVariants: Variant[] = (['amd64', 'arm64'] as const).map((arch) => variant(arch, windows(arch)));

const linuxFormats = ['deb', 'rpm', 'AppImage'] as const;
const linuxArches = ['amd64', 'arm64'] as const;
const linuxSegments: Segment[] = [
  {
    label: d.selectFormat,
    defaultValue: 'deb',
    options: linuxFormats.map((format) => ({
      value: format,
      label: format === 'AppImage' ? 'AppImage' : `.${format}`,
    })),
  },
  {
    label: d.selectArch,
    defaultValue: 'amd64',
    options: [
      { value: 'amd64', label: a.winAmd64 },
      { value: 'arm64', label: a.winArm64 },
    ],
  },
];
const linuxVariants: Variant[] = linuxFormats.flatMap((format) =>
  linuxArches.map((arch) => variant(`${format}:${arch}`, linux(arch, format))),
);

const cards = [
  { id: 'mac', platform: d.platforms.mac, segments: macSegments, variants: macVariants },
  { id: 'windows', platform: d.platforms.windows, segments: winSegments, variants: winVariants },
  { id: 'linux', platform: d.platforms.linux, segments: linuxSegments, variants: linuxVariants },
] as const;
---

<section id="download" class="mx-auto max-w-page px-6 py-20 sm:py-28" data-reveal>
  <h2 class="text-display-sm font-medium tracking-heading">{d.title}</h2>
  <p class="mt-2.5 max-w-measure text-body text-muted-foreground text-pretty">
    {d.leadPrefix} {RELEASE.tag} · {beforeChecksums}
    {
      RELEASE.checksums ? (
        <a href={RELEASE.checksums} class="text-foreground underline underline-offset-[3px] decoration-border-strong transition-colors hover:decoration-foreground">
          SHA256SUMS.txt
        </a>
      ) : (
        'SHA256SUMS.txt'
      )
    }
    {afterChecksums}
  </p>

  <div class="mt-9 grid gap-3 md:grid-cols-3">
    {
      cards.map((card) => (
        <div class="flex flex-col gap-4 rounded-2xl border border-border bg-card p-6">
          <div class="flex items-start gap-3">
            <PlatformIcon platform={card.id} size={19} class="mt-0.5 shrink-0" />
            <div>
              <div class="text-prose font-medium">{card.platform.name}</div>
              <div class="mt-0.5 text-caption text-subtle-foreground">
                {card.platform.requirement}
              </div>
            </div>
          </div>
          <PlatformPicker
            cta={card.platform.cta}
            mirror={d.mirror}
            segments={card.segments}
            variants={card.variants}
          />
        </div>
      ))
    }
  </div>

  <p class="mt-6 text-caption text-muted-foreground">
    {d.noteMac}{' '}
    <a href={installDoc} class="underline underline-offset-[3px] decoration-border-strong transition-colors hover:decoration-foreground">{d.noteMacLink}</a>
    <br />
    {d.noteLinux}{' '}
    <a href={RELEASES_URL} class="underline underline-offset-[3px] decoration-border-strong transition-colors hover:decoration-foreground">
      {d.noteLinuxLink}
    </a>
  </p>
</section>
