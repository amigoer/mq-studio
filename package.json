{
  "name": "rocket-leaf",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "npm --prefix desktop run dev",
    "generate:api": "npm --prefix desktop run generate:api",
    "build:daemon": "sh scripts/build-daemon.sh",
    "build:desktop": "npm --prefix desktop run build",
    "build": "npm run build:daemon && npm run build:desktop",
    "package": "sh scripts/package-current.sh",
    "format": "prettier --write . && gofmt -w daemon",
    "format:check": "prettier --check .",
    "go:fmt:check": "sh scripts/check-gofmt.sh",
    "go:vet": "cd daemon && go vet ./...",
    "desktop:type-check": "npm --prefix desktop run type-check",
    "test": "npm run test:go && npm run test:desktop && npm run test:daemon-smoke",
    "test:go": "cd daemon && go test ./...",
    "test:desktop": "npm --prefix desktop test",
    "test:daemon-smoke": "node scripts/smoke-daemon.mjs",
    "check:contract": "sh scripts/check-contract.sh",
    "check": "npm run format:check && npm run go:fmt:check && npm run go:vet && npm run desktop:type-check && npm test && npm run check:contract"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "shadcn": "^4.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,json,md,yml,yaml}": "prettier --write",
    "*.go": "gofmt -w"
  }
}
